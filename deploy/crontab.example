# Run as the diazbets user (sudo -u diazbets crontab -e). Times are server time; adjust if the server is not on Budapest time.
# 07:00 - collect today's matches, odds, injuries, H2H and generate tips
0 7 * * *  cd /opt/diazbets && set -a && . ./.env && set +a && .venv/bin/python collect.py collect >> data/collect.log 2>&1
# 01:30 and 07:45 - fetch results and settle tips
30 1 * * * cd /opt/diazbets && set -a && . ./.env && set +a && .venv/bin/python collect.py settle >> data/collect.log 2>&1
45 7 * * * cd /opt/diazbets && set -a && . ./.env && set +a && .venv/bin/python collect.py settle >> data/collect.log 2>&1
# szorzómozgás követése: 3 óránként frissíti a szorzókat és újraszámolja a tippeket (kb. 3-8 API-kérés / futás)
15 8-20/3 * * * cd /opt/diazbets && set -a && . ./.env && set +a && .venv/bin/python collect.py odds >> data/collect.log 2>&1
