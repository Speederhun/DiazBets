# Másold .env néven, és töltsd ki. A .env fájl NEM kerülhet a gitbe.
API_FOOTBALL_KEY=ide_jon_az_api_football_kulcs
# Hosszú véletlen szöveg: python3 -c "import secrets; print(secrets.token_hex(32))"
DIAZBETS_SECRET=
# Csomag: free vagy pro. Pro esetén 7000 kérés/napos keret és gyors lekérés (felülírható: DIAZBETS_DAILY_BUDGET, DIAZBETS_REQUEST_DELAY)
DIAZBETS_PLAN=pro
# Mennyire vegyítse a modell a fogadóirodai szorzókból számolt esélyt (0 = csak saját modell, 1 = csak szorzó)
DIAZBETS_MARKET_WEIGHT=0.5
